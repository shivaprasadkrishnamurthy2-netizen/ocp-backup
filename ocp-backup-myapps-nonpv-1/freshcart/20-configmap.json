    "items":  [
                  {
                      "apiVersion":  "v1",
                      "data":  {
                                   "index.html":  "\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n\u003cmeta charset=\"utf-8\"\u003e\n\u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1\"\u003e\n\u003ctitle\u003eFreshCart – Groceries delivered today\u003c/title\u003e\n\u003clink rel=\"preconnect\" href=\"https://fonts.googleapis.com\"\u003e\n\u003clink rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900\u0026display=swap\" rel=\"stylesheet\"\u003e\n\u003cstyle\u003e\n:root{\n  --plum:#3A1E2E; --plum2:#2A1522; --mustard:#E3A72D; --mustard-ink:#5A3B08;\n  --cream:#FBF3E4; --paper:#FFFFFF; --ink:#2B2118; --muted:#78695A;\n  --sage:#6E8B63; --sage-bg:#EAF0E3; --line:#E8DFC9; --berry:#8C2F3E\n}\n*{box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{margin:0;background:var(--cream);color:var(--ink);font:16px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\nh1,h2,.logo,.slotpill b{font-family:Fraunces,Georgia,serif}\nbutton,input,select{font:inherit;color:inherit}\n:focus-visible{outline:3px solid var(--berry);outline-offset:2px}\n\nheader{background:var(--plum);color:var(--cream)}\n.topbar{max-width:1180px;margin:auto;padding:18px 24px 0;display:flex;justify-content:space-between;align-items:flex-start;gap:20px;flex-wrap:wrap}\n.brand{display:flex;flex-direction:column;gap:2px}\n.logo{font-weight:900;font-size:30px;letter-spacing:-.5px;color:var(--mustard)}\n.tag{font-size:13px;color:#d8c7cd}\n.slotpill{background:var(--plum2);border:1px solid #5c3a4c;border-radius:99px;padding:8px 16px;font-size:13px;display:flex;align-items:center;gap:8px;white-space:nowrap}\n.slotpill b{color:var(--mustard);font-weight:700}\n.searchrow{max-width:1180px;margin:16px auto 0;padding:0 24px 20px;display:flex;gap:14px;flex-wrap:wrap}\n.search{flex:1;min-width:200px}\n.search input{width:100%;padding:12px 16px;border:0;border-radius:10px;background:var(--cream);color:var(--ink)}\n.cartbtn{background:var(--mustard);color:var(--plum2);border:0;border-radius:10px;padding:12px 20px;font-weight:800;cursor:pointer;white-space:nowrap;display:flex;gap:8px;align-items:center}\n.cartbtn small{font-weight:600;opacity:.75}\n\n.hero{max-width:1180px;margin:auto;padding:40px 24px 8px;display:grid;grid-template-columns:1.3fr .7fr;gap:30px;align-items:center}\n.hero h1{margin:0 0 14px;font-size:clamp(30px,4vw,48px);line-height:1.05;font-weight:700;max-width:14ch}\n.hero p{margin:0;color:var(--muted);max-width:48ch;font-size:16px}\n.crate{aspect-ratio:1/1;border-radius:28px;background:var(--mustard);display:grid;place-items:center;font-size:64px;position:relative;overflow:hidden}\n.crate::before{content:\"\";position:absolute;inset:10px;border:3px dashed rgba(58,30,46,.35);border-radius:20px}\n.crate span{position:relative;z-index:1}\n\n.shell{max-width:1180px;margin:auto;padding:26px 24px 60px;display:grid;grid-template-columns:200px 1fr;gap:28px;align-items:start}\n.rail{position:sticky;top:20px;display:flex;flex-direction:column;gap:6px}\n.rail button{text-align:left;background:none;border:0;border-radius:10px;padding:10px 12px;cursor:pointer;font-size:14px;display:flex;gap:10px;align-items:center;color:var(--ink)}\n.rail button[aria-pressed=true]{background:var(--paper);box-shadow:0 1px 0 var(--line);font-weight:700;color:var(--berry)}\n.rail .ic{font-size:18px}\n.section-title{font-size:22px;font-weight:700;margin:0 0 14px;display:flex;align-items:center;gap:10px}\n.section-title .ic{font-size:22px}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:16px;margin-bottom:30px}\n.card{background:var(--paper);border:1px solid var(--line);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;position:relative}\n.tile{height:112px;display:grid;place-items:center;font-size:48px;background:var(--sage-bg)}\n.tag-org{position:absolute;top:8px;left:8px;background:var(--sage);color:#fff;font-size:11px;padding:3px 9px;border-radius:99px;z-index:1}\n.body{padding:12px 14px 14px;display:flex;flex-direction:column;gap:4px;flex:1}\n.unit{font-size:12px;color:var(--muted)}\n.body h3{margin:0;font-size:15.5px;font-weight:600}\n.row{display:flex;align-items:center;justify-content:space-between;margin-top:8px}\n.pricewrap{display:flex;align-items:baseline;gap:6px}\n.price{font-family:Fraunces,serif;font-weight:700;font-size:19px}\n.was{font-size:12px;color:var(--muted);text-decoration:line-through}\n.add{background:var(--berry);color:#fff;border:0;border-radius:8px;width:32px;height:32px;font-size:19px;cursor:pointer;line-height:1}\n.stepper{display:flex;align-items:center;gap:6px;background:var(--berry);border-radius:8px;padding:4px 6px}\n.stepper button{background:none;border:0;color:#fff;font-size:17px;width:22px;cursor:pointer}\n.stepper span{color:#fff;font-weight:700;min-width:12px;text-align:center;font-size:14px}\n.empty{grid-column:1/-1;text-align:center;color:var(--muted);padding:50px 0}\nfooter{text-align:center;color:var(--muted);font-size:13px;padding:8px 24px 30px}\n\n.scrim{position:fixed;inset:0;background:rgba(20,10,16,.5);display:none;z-index:9}\n.scrim.on{display:block}\naside{position:fixed;top:0;right:0;height:100%;width:min(400px,100%);background:var(--paper);z-index:10;transform:translateX(100%);transition:transform .25s;display:flex;flex-direction:column;box-shadow:-8px 0 24px rgba(0,0,0,.1)}\naside.on{transform:none}\n.receipt-head{background:var(--plum);color:var(--cream);padding:18px 20px;display:flex;justify-content:space-between;align-items:center}\n.receipt-head h2{margin:0;font-size:21px;font-weight:700}\n.x{background:none;border:0;font-size:24px;cursor:pointer;line-height:1;color:var(--cream)}\n#lines{flex:1;overflow:auto;padding:6px 20px}\n.line{display:grid;grid-template-columns:34px 1fr auto;gap:10px;align-items:center;padding:12px 0;border-bottom:1px dashed var(--line)}\n.line .ic{font-size:22px;text-align:center}\n.line b{display:block;font-size:14px;font-weight:600}\n.qty{display:inline-flex;align-items:center;gap:8px;margin-top:4px}\n.qty button{width:22px;height:22px;border:1px solid var(--line);border-radius:6px;background:#fff;cursor:pointer;font-size:13px}\n.sum{border-top:2px dashed var(--line);padding:16px 20px 20px;font-family:ui-monospace,\"SF Mono\",Consolas,monospace}\n.sum div{display:flex;justify-content:space-between;font-size:14px;margin-bottom:6px}\n.sum .t{font-family:Fraunces,serif;font-size:20px;font-weight:700}\n.note{font-family:system-ui,sans-serif;font-size:12.5px;color:var(--muted);margin:6px 0 10px}\n.co{background:var(--mustard);color:var(--plum2);border:0;border-radius:10px;padding:13px;font-weight:800;cursor:pointer;margin-top:6px;width:100%;font-family:system-ui,sans-serif;font-size:15px}\n.co:disabled{opacity:.4;cursor:not-allowed}\n\n.modal{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:min(440px,92%);background:var(--paper);border-radius:16px;padding:26px;z-index:11;display:none}\n.modal.on{display:block}\n.modal h2{margin:0 0 6px;font-size:24px;font-weight:700}\n.modal label{display:block;margin-top:12px;font-size:13.5px;color:var(--muted)}\n.modal input,.modal select{width:100%;padding:10px;border:1px solid var(--line);border-radius:8px;margin-top:4px}\n\n@media (max-width:820px){\n  .hero{grid-template-columns:1fr}\n  .crate{max-width:220px;justify-self:start}\n  .shell{grid-template-columns:1fr}\n  .rail{position:static;flex-direction:row;overflow-x:auto;gap:8px;padding-bottom:4px}\n  .rail button{white-space:nowrap}\n}\n@media (prefers-reduced-motion:reduce){aside{transition:none}}\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003cheader\u003e\n  \u003cdiv class=\"topbar\"\u003e\n    \u003cdiv class=\"brand\"\u003e\u003cspan class=\"logo\"\u003eFreshCart\u003c/span\u003e\u003cspan class=\"tag\"\u003eLocal produce \u0026 pantry, delivered\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"slotpill\"\u003e📦 Arriving \u003cb id=\"slotb\"\u003etoday, 5–7 PM\u003c/b\u003e\u003c/div\u003e\n  \u003c/div\u003e\n  \u003cdiv class=\"searchrow\"\u003e\n    \u003cdiv class=\"search\"\u003e\u003cinput id=\"q\" type=\"search\" placeholder=\"Search apples, milk, bread…\" aria-label=\"Search groceries\"\u003e\u003c/div\u003e\n    \u003cbutton class=\"cartbtn\" id=\"open\"\u003e🧺 Basket \u003csmall\u003e(\u003cspan id=\"cnt\"\u003e0\u003c/span\u003e)\u003c/small\u003e — \u003cspan id=\"minitot\"\u003e$0.00\u003c/span\u003e\u003c/button\u003e\n  \u003c/div\u003e\n\u003c/header\u003e\n\n\u003csection class=\"hero\"\u003e\n  \u003cdiv\u003e\n    \u003ch1\u003eThe farm stand, brought to your door.\u003c/h1\u003e\n    \u003cp\u003eFresh produce, dairy and pantry staples, hand-picked and delivered in the window you choose.\u003c/p\u003e\n  \u003c/div\u003e\n  \u003cdiv class=\"crate\" aria-hidden=\"true\"\u003e\u003cspan\u003e🧺\u003c/span\u003e\u003c/div\u003e\n\u003c/section\u003e\n\n\u003cdiv class=\"shell\"\u003e\n  \u003cnav class=\"rail\" id=\"rail\"\u003e\u003c/nav\u003e\n  \u003cdiv id=\"mainc\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\n\u003cfooter\u003eDemo grocery storefront running on OpenShift. Orders are simulated and nothing is stored on the server.\u003c/footer\u003e\n\n\u003cdiv class=\"scrim\" id=\"scrim\"\u003e\u003c/div\u003e\n\u003caside id=\"cart\" aria-label=\"Shopping basket\"\u003e\n  \u003cdiv class=\"receipt-head\"\u003e\u003ch2\u003eYour basket\u003c/h2\u003e\u003cbutton class=\"x\" id=\"close\" aria-label=\"Close basket\"\u003e\u0026times;\u003c/button\u003e\u003c/div\u003e\n  \u003cdiv id=\"lines\"\u003e\u003c/div\u003e\n  \u003cdiv class=\"sum\"\u003e\n    \u003cdiv\u003e\u003cspan\u003eSubtotal\u003c/span\u003e\u003cspan id=\"sub\"\u003e$0.00\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv\u003e\u003cspan\u003eDelivery\u003c/span\u003e\u003cspan id=\"ship\"\u003e$0.00\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"t\"\u003e\u003cspan\u003eTotal\u003c/span\u003e\u003cspan id=\"tot\"\u003e$0.00\u003c/span\u003e\u003c/div\u003e\n    \u003cdiv class=\"note\" id=\"freenote\"\u003e\u003c/div\u003e\n    \u003cbutton class=\"co\" id=\"checkout\" disabled\u003eChoose delivery slot\u003c/button\u003e\n  \u003c/div\u003e\n\u003c/aside\u003e\n\n\u003cdiv class=\"modal\" id=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"mt\"\u003e\u003c/div\u003e\n\n\u003cscript\u003e\nconst P=[\n{id:1,n:\"Organic Bananas\",c:\"Produce\",u:\"per bunch\",p:2.49,i:\"🍌\",org:1,s:60},\n{id:2,n:\"Vine Tomatoes\",c:\"Produce\",u:\"1 lb\",p:2.99,was:3.49,i:\"🍅\",s:44},\n{id:3,n:\"Avocados\",c:\"Produce\",u:\"each\",p:1.79,i:\"🥑\",org:1,s:70},\n{id:4,n:\"Baby Spinach\",c:\"Produce\",u:\"5 oz box\",p:3.29,i:\"🥬\",org:1,s:38},\n{id:5,n:\"Whole Milk\",c:\"Dairy\",u:\"half gallon\",p:3.49,i:\"🥛\",s:52},\n{id:6,n:\"Large Eggs\",c:\"Dairy\",u:\"dozen\",p:4.19,i:\"🥚\",s:66},\n{id:7,n:\"Greek Yogurt\",c:\"Dairy\",u:\"32 oz tub\",p:5.49,was:6.29,i:\"🍦\",s:29},\n{id:8,n:\"Sharp Cheddar\",c:\"Dairy\",u:\"8 oz block\",p:4.79,i:\"🧀\",s:24},\n{id:9,n:\"Sourdough Loaf\",c:\"Bakery\",u:\"each\",p:4.99,i:\"🍞\",s:20},\n{id:10,n:\"Everything Bagels\",c:\"Bakery\",u:\"pack of 6\",p:3.79,i:\"🥯\",s:33},\n{id:11,n:\"Chocolate Croissants\",c:\"Bakery\",u:\"pack of 4\",p:5.29,i:\"🥐\",s:18},\n{id:12,n:\"Chicken Breast\",c:\"Meat \u0026 Seafood\",u:\"1 lb\",p:6.99,i:\"🍗\",s:26},\n{id:13,n:\"Atlantic Salmon\",c:\"Meat \u0026 Seafood\",u:\"1 lb fillet\",p:11.49,i:\"🐟\",s:14},\n{id:14,n:\"Ground Beef 85%\",c:\"Meat \u0026 Seafood\",u:\"1 lb\",p:7.49,i:\"🥩\",s:22},\n{id:15,n:\"Penne Pasta\",c:\"Pantry\",u:\"16 oz box\",p:1.89,i:\"🍝\",s:80},\n{id:16,n:\"Extra Virgin Olive Oil\",c:\"Pantry\",u:\"500 ml\",p:8.99,i:\"🫒\",s:31},\n{id:17,n:\"Jasmine Rice\",c:\"Pantry\",u:\"5 lb bag\",p:6.49,i:\"🍚\",s:40},\n{id:18,n:\"Peanut Butter\",c:\"Pantry\",u:\"16 oz jar\",p:3.99,i:\"🥜\",s:35},\n{id:19,n:\"Orange Juice\",c:\"Beverages\",u:\"52 fl oz\",p:4.49,i:\"🧃\",s:27},\n{id:20,n:\"Sparkling Water, 8-pk\",c:\"Beverages\",u:\"12 fl oz cans\",p:5.99,i:\"🥤\",s:36},\n{id:21,n:\"Cold Brew Coffee\",c:\"Beverages\",u:\"32 fl oz\",p:4.79,was:5.29,i:\"☕\",s:19},\n{id:22,n:\"Frozen Mixed Berries\",c:\"Frozen\",u:\"12 oz bag\",p:4.29,i:\"🫐\",org:1,s:24},\n{id:23,n:\"Frozen Pizza, Margherita\",c:\"Frozen\",u:\"14 oz\",p:5.49,i:\"🍕\",s:21},\n{id:24,n:\"Vanilla Ice Cream\",c:\"Frozen\",u:\"1.5 qt tub\",p:5.99,i:\"🍨\",s:16}];\nconst CATIC={Produce:\"🥕\",\"Meat \u0026 Seafood\":\"🍗\",Dairy:\"🥛\",Bakery:\"🍞\",Pantry:\"🥫\",Beverages:\"🧃\",Frozen:\"🧊\"};\nconst $=s=\u003edocument.querySelector(s), money=n=\u003e\"$\"+n.toFixed(2);\nlet cart={};\ntry{cart=JSON.parse(localStorage.getItem(\"fc-cart\")||\"{}\")}catch(e){}\nconst save=()=\u003e{try{localStorage.setItem(\"fc-cart\",JSON.stringify(cart))}catch(e){}};\n\nfunction rail(){\n  const cs=[\"All\",...Object.keys(CATIC)];\n  $(\"#rail\").innerHTML=cs.map(c=\u003e`\u003cbutton aria-pressed=\"${c==window._cat}\" data-c=\"${c}\"\u003e\u003cspan class=\"ic\"\u003e${c==\"All\"?\"🧺\":CATIC[c]}\u003c/span\u003e${c}\u003c/button\u003e`).join(\"\");\n}\nfunction productCard(x){\n  const q=cart[x.id]||0;\n  return `\u003carticle class=\"card\"\u003e${x.org?\u0027\u003cspan class=\"tag-org\"\u003eOrganic\u003c/span\u003e\u0027:\u0027\u0027}\u003cdiv class=\"tile\" aria-hidden=\"true\"\u003e${x.i}\u003c/div\u003e\n   \u003cdiv class=\"body\"\u003e\u003cspan class=\"unit\"\u003e${x.u}\u003c/span\u003e\u003ch3\u003e${x.n}\u003c/h3\u003e\n   \u003cdiv class=\"row\"\u003e\n     \u003cspan class=\"pricewrap\"\u003e${x.was?`\u003cspan class=\"was\"\u003e${money(x.was)}\u003c/span\u003e`:\u0027\u0027}\u003cspan class=\"price\"\u003e${money(x.p)}\u003c/span\u003e\u003c/span\u003e\n     ${q\u003e0?`\u003cdiv class=\"stepper\"\u003e\u003cbutton data-m=\"${x.id}\" aria-label=\"Remove one\"\u003e−\u003c/button\u003e\u003cspan\u003e${q}\u003c/span\u003e\u003cbutton data-p=\"${x.id}\" aria-label=\"Add one\"\u003e+\u003c/button\u003e\u003c/div\u003e`\n          :`\u003cbutton class=\"add\" data-id=\"${x.id}\" aria-label=\"Add ${x.n}\"\u003e+\u003c/button\u003e`}\n   \u003c/div\u003e\u003c/div\u003e\u003c/article\u003e`;\n}\nfunction main(){\n  const q=$(\"#q\").value.toLowerCase().trim();\n  const cat=window._cat||\"All\";\n  let l=P.filter(x=\u003e(cat==\"All\"||x.c==cat)\u0026\u0026(x.n+x.c).toLowerCase().includes(q));\n  if(!l.length){$(\"#mainc\").innerHTML=`\u003cdiv class=\"empty\"\u003eNo products match “${q}”. Try another search or category.\u003c/div\u003e`;return}\n  if(cat!=\"All\"){$(\"#mainc\").innerHTML=`\u003ch2 class=\"section-title\"\u003e\u003cspan class=\"ic\"\u003e${CATIC[cat]}\u003c/span\u003e${cat}\u003c/h2\u003e\u003cdiv class=\"grid\"\u003e${l.map(productCard).join(\"\")}\u003c/div\u003e`;return}\n  const groups=Object.keys(CATIC).map(c=\u003e({c,items:l.filter(x=\u003ex.c==c)})).filter(g=\u003eg.items.length);\n  $(\"#mainc\").innerHTML=groups.map(g=\u003e`\u003ch2 class=\"section-title\"\u003e\u003cspan class=\"ic\"\u003e${CATIC[g.c]}\u003c/span\u003e${g.c}\u003c/h2\u003e\u003cdiv class=\"grid\"\u003e${g.items.map(productCard).join(\"\")}\u003c/div\u003e`).join(\"\");\n}\nfunction draw(){\n  const ids=Object.keys(cart).filter(k=\u003ecart[k]\u003e0);\n  let sub=0,n=0;\n  $(\"#lines\").innerHTML=ids.length?ids.map(k=\u003e{const x=P.find(p=\u003ep.id==k);sub+=x.p*cart[k];n+=cart[k];\n   return `\u003cdiv class=\"line\"\u003e\u003cdiv class=\"ic\"\u003e${x.i}\u003c/div\u003e\u003cdiv\u003e\u003cb\u003e${x.n}\u003c/b\u003e\u003cdiv class=\"qty\"\u003e\u003cbutton data-m=\"${k}\" aria-label=\"Remove one\"\u003e−\u003c/button\u003e\u003cspan\u003e${cart[k]}\u003c/span\u003e\u003cbutton data-p=\"${k}\" aria-label=\"Add one\"\u003e+\u003c/button\u003e\u003c/div\u003e\u003c/div\u003e\u003cb\u003e${money(x.p*cart[k])}\u003c/b\u003e\u003c/div\u003e`}).join(\"\"):`\u003cp class=\"note\" style=\"padding:24px 0\"\u003eYour basket is empty. Add some groceries from the shop.\u003c/p\u003e`;\n  const ship=sub==0||sub\u003e=50?0:4.99;\n  $(\"#cnt\").textContent=n; $(\"#minitot\").textContent=money(sub);\n  $(\"#sub\").textContent=money(sub); $(\"#ship\").textContent=sub?(ship?money(ship):\"Free\"):\"$0.00\";\n  $(\"#tot\").textContent=money(sub+ship);\n  $(\"#freenote\").textContent=sub\u0026\u0026sub\u003c50?`Add ${money(50-sub)} more for free delivery.`:\"\";\n  $(\"#checkout\").disabled=!ids.length; save(); main();\n}\nconst show=on=\u003e{$(\"#cart\").classList.toggle(\"on\",on);$(\"#scrim\").classList.toggle(\"on\",on);if(!on)$(\"#modal\").classList.remove(\"on\")};\ndocument.addEventListener(\"click\",e=\u003e{\n  const t=e.target;\n  if(t.dataset\u0026\u0026t.dataset.c){window._cat=t.dataset.c;rail();main()}\n  if(t.classList\u0026\u0026t.classList.contains(\"add\")){cart[t.dataset.id]=(cart[t.dataset.id]||0)+1;draw()}\n  if(t.dataset\u0026\u0026t.dataset.p){cart[t.dataset.p]++;draw()}\n  if(t.dataset\u0026\u0026t.dataset.m){cart[t.dataset.m]--;draw()}\n  if(t.id==\"open\")show(true); if(t.id==\"close\"||t.id==\"scrim\"||t.id==\"done\")show(false);\n  if(t.id==\"checkout\"){$(\"#modal\").innerHTML=`\u003ch2 id=\"mt\"\u003eDelivery details\u003c/h2\u003e\n    \u003clabel\u003eFull name\u003cinput id=\"nm\"\u003e\u003c/label\u003e\n    \u003clabel\u003eDelivery address\u003cinput id=\"ad\"\u003e\u003c/label\u003e\n    \u003clabel\u003eDelivery window\u003cselect id=\"win\"\u003e\n      \u003coption\u003eToday, 5–7 PM\u003c/option\u003e\u003coption\u003eToday, 7–9 PM\u003c/option\u003e\n      \u003coption\u003eTomorrow, 8–10 AM\u003c/option\u003e\u003coption\u003eTomorrow, 12–2 PM\u003c/option\u003e\n    \u003c/select\u003e\u003c/label\u003e\n    \u003cbutton class=\"co\" id=\"pay\"\u003ePlace order — ${$(\"#tot\").textContent}\u003c/button\u003e`;$(\"#modal\").classList.add(\"on\")}\n  if(t.id==\"pay\"){\n    if(!$(\"#nm\").value||!$(\"#ad\").value){$(\"#nm\").focus();return}\n    const no=\"FC-\"+Math.floor(100000+Math.random()*900000);\n    $(\"#slotb\").textContent=$(\"#win\").value;\n    $(\"#modal\").innerHTML=`\u003ch2 id=\"mt\"\u003eOrder confirmed\u003c/h2\u003e\u003cp\u003eThanks, ${$(\"#nm\").value}. Order \u003cb\u003e${no}\u003c/b\u003e will arrive at ${$(\"#ad\").value} during \u003cb\u003e${$(\"#win\").value}\u003c/b\u003e.\u003c/p\u003e\u003cbutton class=\"co\" id=\"done\"\u003eContinue shopping\u003c/button\u003e`;\n    cart={};draw();\n  }\n});\n$(\"#q\").addEventListener(\"input\",main);\ndocument.addEventListener(\"keydown\",e=\u003e{if(e.key==\"Escape\")show(false)});\nwindow._cat=\"All\";\nrail();draw();\n\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n"
                               },
