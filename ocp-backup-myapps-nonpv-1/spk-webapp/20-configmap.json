                      "data":  {
                                   "index.html":  "\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n  \u003cmeta charset=\"UTF-8\"\u003e\n  \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1\"\u003e\n  \u003ctitle\u003eOpenShift SNO - Hello\u003c/title\u003e\n  \u003cstyle\u003e\n    :root { --bg1:#0f172a; --bg2:#1e1b4b; --card:rgba(255,255,255,.07); --text:#e2e8f0; --muted:#94a3b8; --accent:#ee0000; --ok:#22c55e; }\n    * { box-sizing:border-box; margin:0; padding:0; }\n    body { min-height:100vh; font-family:\"Segoe UI\",system-ui,sans-serif; color:var(--text);\n           background:linear-gradient(135deg,var(--bg1),var(--bg2)); display:flex; flex-direction:column; align-items:center; padding:48px 20px; }\n    header { text-align:center; margin-bottom:36px; }\n    .logo { width:72px; height:72px; border-radius:50%; background:var(--accent); margin:0 auto 18px; display:grid; place-items:center;\n            font-size:34px; font-weight:700; box-shadow:0 0 40px rgba(238,0,0,.45); }\n    h1 { font-size:2.4rem; letter-spacing:.5px; }\n    h1 span { color:var(--accent); }\n    p.sub { color:var(--muted); margin-top:8px; }\n    .status { display:inline-flex; align-items:center; gap:8px; margin-top:16px; padding:6px 14px; border-radius:999px; background:var(--card); font-size:.9rem; }\n    .dot { width:10px; height:10px; border-radius:50%; background:var(--ok); animation:pulse 1.6s infinite; }\n    @keyframes pulse { 0%{box-shadow:0 0 0 0 rgba(34,197,94,.6)} 70%{box-shadow:0 0 0 10px rgba(34,197,94,0)} 100%{box-shadow:0 0 0 0 rgba(34,197,94,0)} }\n    .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:18px; width:100%; max-width:900px; }\n    .card { background:var(--card); border:1px solid rgba(255,255,255,.1); border-radius:16px; padding:22px; backdrop-filter:blur(6px); transition:transform .2s; }\n    .card:hover { transform:translateY(-4px); }\n    .card h3 { font-size:.8rem; text-transform:uppercase; letter-spacing:1.5px; color:var(--muted); margin-bottom:10px; }\n    .card .val { font-size:1.5rem; font-weight:600; }\n    footer { margin-top:40px; color:var(--muted); font-size:.85rem; }\n  \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n  \u003cheader\u003e\n    \u003cdiv class=\"logo\"\u003eOS\u003c/div\u003e\n    \u003ch1\u003eHello from \u003cspan\u003eOpenShift\u003c/span\u003e SNO\u003c/h1\u003e\n    \u003cp class=\"sub\"\u003eDeployed by a regular (non-admin) user with a Deployment, Service and Route\u003c/p\u003e\n    \u003cdiv class=\"status\"\u003e\u003cspan class=\"dot\"\u003e\u003c/span\u003e Application is running\u003c/div\u003e\n  \u003c/header\u003e\n\n  \u003csection class=\"grid\"\u003e\n    \u003cdiv class=\"card\"\u003e\u003ch3\u003eLocal time\u003c/h3\u003e\u003cdiv class=\"val\" id=\"time\"\u003e--\u003c/div\u003e\u003c/div\u003e\n    \u003cdiv class=\"card\"\u003e\u003ch3\u003eDate\u003c/h3\u003e\u003cdiv class=\"val\" id=\"date\"\u003e--\u003c/div\u003e\u003c/div\u003e\n    \u003cdiv class=\"card\"\u003e\u003ch3\u003eServed from\u003c/h3\u003e\u003cdiv class=\"val\" id=\"host\"\u003e--\u003c/div\u003e\u003c/div\u003e\n    \u003cdiv class=\"card\"\u003e\u003ch3\u003eYour browser\u003c/h3\u003e\u003cdiv class=\"val\" id=\"ua\"\u003e--\u003c/div\u003e\u003c/div\u003e\n  \u003c/section\u003e\n\n  \u003cfooter\u003enginx on Red Hat UBI \u0026bull; running as a random non-root UID\u003c/footer\u003e\n\n  \u003cscript\u003e\n    function tick() {\n      const d = new Date();\n      document.getElementById(\u0027time\u0027).textContent = d.toLocaleTimeString();\n      document.getElementById(\u0027date\u0027).textContent = d.toLocaleDateString(undefined,{weekday:\u0027long\u0027,month:\u0027short\u0027,day:\u0027numeric\u0027});\n    }\n    tick(); setInterval(tick, 1000);\n    document.getElementById(\u0027host\u0027).textContent = location.host;\n    const ua = navigator.userAgent;\n    document.getElementById(\u0027ua\u0027).textContent = ua.includes(\u0027Edg\u0027) ? \u0027Edge\u0027 : ua.includes(\u0027Chrome\u0027) ? \u0027Chrome\u0027 : ua.includes(\u0027Firefox\u0027) ? \u0027Firefox\u0027 : ua.includes(\u0027Safari\u0027) ? \u0027Safari\u0027 : \u0027Browser\u0027;\n  \u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n"
                               },
                      "kind":  "ConfigMap",
                      "metadata":  {
