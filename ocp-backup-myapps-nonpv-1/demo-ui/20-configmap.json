                  {
                      "apiVersion":  "v1",
                      "data":  {
                                   "index.html":  "\u003c!DOCTYPE html\u003e\n\u003chtml\u003e\n\u003chead\u003e\n  \u003cmeta charset=\"UTF-8\"\u003e\n  \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\u003e\n  \u003ctitle\u003eOpenShift SNO Demo\u003c/title\u003e\n\n  \u003cstyle\u003e\n    * {\n      box-sizing: border-box;\n    }\n\n    body {\n      margin: 0;\n      font-family: Arial, sans-serif;\n      background: #0b1120;\n      color: #e5e7eb;\n    }\n\n    .header {\n      background: #111827;\n      padding: 25px 40px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      border-bottom: 1px solid #374151;\n    }\n\n    .logo {\n      display: flex;\n      align-items: center;\n      gap: 15px;\n    }\n\n    .logo-icon {\n      width: 48px;\n      height: 48px;\n      border-radius: 12px;\n      background: #ee0000;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 25px;\n      font-weight: bold;\n    }\n\n    h1 {\n      margin: 0;\n      font-size: 22px;\n    }\n\n    .subtitle {\n      color: #9ca3af;\n      font-size: 13px;\n      margin-top: 5px;\n    }\n\n    .status {\n      background: #172554;\n      padding: 10px 18px;\n      border-radius: 20px;\n    }\n\n    .dot {\n      display: inline-block;\n      width: 10px;\n      height: 10px;\n      background: #22c55e;\n      border-radius: 50%;\n      margin-right: 8px;\n    }\n\n    .container {\n      max-width: 1200px;\n      margin: auto;\n      padding: 45px 30px;\n    }\n\n    h2 {\n      font-size: 36px;\n      margin-bottom: 10px;\n    }\n\n    .intro {\n      color: #9ca3af;\n      margin-bottom: 35px;\n    }\n\n    .grid {\n      display: grid;\n      grid-template-columns:\n        repeat(auto-fit, minmax(220px, 1fr));\n      gap: 20px;\n    }\n\n    .card {\n      background: #111827;\n      border: 1px solid #374151;\n      border-radius: 15px;\n      padding: 25px;\n    }\n\n    .card-title {\n      color: #9ca3af;\n      font-size: 12px;\n      text-transform: uppercase;\n      margin-bottom: 15px;\n    }\n\n    .value {\n      font-size: 28px;\n      font-weight: bold;\n    }\n\n    .green {\n      color: #22c55e;\n    }\n\n    .blue {\n      color: #60a5fa;\n    }\n\n    .red {\n      color: #ef4444;\n    }\n\n    .orange {\n      color: #fb923c;\n    }\n\n    .small {\n      color: #6b7280;\n      font-size: 13px;\n      margin-top: 8px;\n    }\n\n    .wide {\n      grid-column: span 2;\n    }\n\n    .row {\n      display: flex;\n      justify-content: space-between;\n      padding: 12px 0;\n      border-bottom: 1px solid #1f2937;\n    }\n\n    .row:last-child {\n      border-bottom: 0;\n    }\n\n    .label {\n      color: #9ca3af;\n    }\n\n    button {\n      margin-top: 20px;\n      padding: 12px 20px;\n      border: 0;\n      border-radius: 8px;\n      background: #ee0000;\n      color: white;\n      font-weight: bold;\n      cursor: pointer;\n    }\n\n    button:hover {\n      background: #cc0000;\n    }\n\n    footer {\n      text-align: center;\n      color: #6b7280;\n      padding: 30px;\n    }\n\n    @media(max-width:700px) {\n      .wide {\n        grid-column: span 1;\n      }\n\n      .header {\n        padding: 20px;\n      }\n\n      .container {\n        padding: 25px;\n      }\n    }\n  \u003c/style\u003e\n\u003c/head\u003e\n\n\u003cbody\u003e\n\n  \u003cdiv class=\"header\"\u003e\n\n    \u003cdiv class=\"logo\"\u003e\n\n      \u003cdiv class=\"logo-icon\"\u003eO\u003c/div\u003e\n\n      \u003cdiv\u003e\n        \u003ch1\u003eOpenShift Demo Platform\u003c/h1\u003e\n        \u003cdiv class=\"subtitle\"\u003e\n          Single Node OpenShift Test Application\n        \u003c/div\u003e\n      \u003c/div\u003e\n\n    \u003c/div\u003e\n\n    \u003cdiv class=\"status\"\u003e\n      \u003cspan class=\"dot\"\u003e\u003c/span\u003e\n      Application Online\n    \u003c/div\u003e\n\n  \u003c/div\u003e\n\n  \u003cdiv class=\"container\"\u003e\n\n    \u003ch2\u003eOpenShift SNO Dashboard\u003c/h2\u003e\n\n    \u003cdiv class=\"intro\"\u003e\n      Sample application running on Red Hat OpenShift 4.22\n      Single Node OpenShift.\n    \u003c/div\u003e\n\n    \u003cdiv class=\"grid\"\u003e\n\n      \u003cdiv class=\"card\"\u003e\n        \u003cdiv class=\"card-title\"\u003ePlatform\u003c/div\u003e\n        \u003cdiv class=\"value red\"\u003eOpenShift\u003c/div\u003e\n        \u003cdiv class=\"small\"\u003eContainer Platform\u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"card\"\u003e\n        \u003cdiv class=\"card-title\"\u003eArchitecture\u003c/div\u003e\n        \u003cdiv class=\"value blue\"\u003eSNO\u003c/div\u003e\n        \u003cdiv class=\"small\"\u003eSingle Node OpenShift\u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"card\"\u003e\n        \u003cdiv class=\"card-title\"\u003eApplication\u003c/div\u003e\n        \u003cdiv class=\"value green\"\u003eHealthy\u003c/div\u003e\n        \u003cdiv class=\"small\"\u003eNGINX Web Server\u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"card\"\u003e\n        \u003cdiv class=\"card-title\"\u003eCurrent Time\u003c/div\u003e\n        \u003cdiv class=\"value\" id=\"clock\"\u003e--:--:--\u003c/div\u003e\n        \u003cdiv class=\"small\"\u003eBrowser Local Time\u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"card wide\"\u003e\n\n        \u003cdiv class=\"card-title\"\u003e\n          Cluster Information\n        \u003c/div\u003e\n\n        \u003cdiv class=\"row\"\u003e\n          \u003cspan class=\"label\"\u003ePlatform\u003c/span\u003e\n          \u003cb\u003eOpenShift 4.22\u003c/b\u003e\n        \u003c/div\u003e\n\n        \u003cdiv class=\"row\"\u003e\n          \u003cspan class=\"label\"\u003eCluster Type\u003c/span\u003e\n          \u003cb\u003eSingle Node\u003c/b\u003e\n        \u003c/div\u003e\n\n        \u003cdiv class=\"row\"\u003e\n          \u003cspan class=\"label\"\u003eNamespace\u003c/span\u003e\n          \u003cb\u003edemo-ui\u003c/b\u003e\n        \u003c/div\u003e\n\n        \u003cdiv class=\"row\"\u003e\n          \u003cspan class=\"label\"\u003eWeb Server\u003c/span\u003e\n          \u003cb\u003eNGINX\u003c/b\u003e\n        \u003c/div\u003e\n\n        \u003cdiv class=\"row\"\u003e\n          \u003cspan class=\"label\"\u003eContainer Port\u003c/span\u003e\n          \u003cb\u003e8080\u003c/b\u003e\n        \u003c/div\u003e\n\n      \u003c/div\u003e\n\n      \u003cdiv class=\"card\"\u003e\n\n        \u003cdiv class=\"card-title\"\u003eDemo Load\u003c/div\u003e\n\n        \u003cdiv class=\"value orange\"\u003e62%\u003c/div\u003e\n\n        \u003cdiv class=\"small\"\u003e\n          Simulated application metric\n        \u003c/div\u003e\n\n      \u003c/div\u003e\n\n      \u003cdiv class=\"card\"\u003e\n\n        \u003cdiv class=\"card-title\"\u003eKubernetes\u003c/div\u003e\n\n        \u003cdiv class=\"value green\"\u003e\n          Ready\n        \u003c/div\u003e\n\n        \u003cdiv class=\"small\"\u003e\n          Container orchestration active\n        \u003c/div\u003e\n\n      \u003c/div\u003e\n\n      \u003cdiv class=\"card\"\u003e\n\n        \u003cdiv class=\"card-title\"\u003eConnectivity\u003c/div\u003e\n\n        \u003cdiv class=\"value green\"\u003e\n          OK\n        \u003c/div\u003e\n\n        \u003cdiv class=\"small\"\u003e\n          HTTP service responding\n        \u003c/div\u003e\n\n        \u003cbutton onclick=\"testApplication()\"\u003e\n          Test Application\n        \u003c/button\u003e\n\n      \u003c/div\u003e\n\n    \u003c/div\u003e\n\n  \u003c/div\u003e\n\n  \u003cfooter\u003e\n    OpenShift SNO Demo Application\n    |\n    OpenShift Container Platform 4.22\n    |\n    \u003cspan id=\"date\"\u003e\u003c/span\u003e\n  \u003c/footer\u003e\n\n  \u003cscript\u003e\n\n    function updateClock() {\n\n      const now = new Date();\n\n      document.getElementById(\"clock\")\n        .innerText = now.toLocaleTimeString();\n\n      document.getElementById(\"date\")\n        .innerText = now.toLocaleDateString();\n\n    }\n\n    function testApplication() {\n\n      alert(\n        \"Application is running successfully on OpenShift SNO!\"\n      );\n\n    }\n\n    updateClock();\n\n    setInterval(updateClock, 1000);\n\n  \u003c/script\u003e\n\n\u003c/body\u003e\n\u003c/html\u003e\n"
                               },
                      "kind":  "ConfigMap",
                      "metadata":  {
                                       "name":  "demo-ui-content",
                                       "namespace":  "demo-ui"
                                   }
                  }
              ]
}