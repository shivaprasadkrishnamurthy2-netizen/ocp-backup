{
    "apiVersion":  "v1",
    "kind":  "List",
    "items":  [
                  {
                      "apiVersion":  "apps/v1",
                      "kind":  "Deployment",
                      "metadata":  {
                                       "name":  "demo-ui",
                                       "namespace":  "demo-ui"
                                   },
                      "spec":  {
                                   "progressDeadlineSeconds":  600,
                                   "replicas":  1,
                                   "revisionHistoryLimit":  10,
                                   "selector":  {
                                                    "matchLabels":  {
                                                                        "app":  "demo-ui"
                                                                    }
                                                },
                                   "strategy":  {
                                                    "rollingUpdate":  {
                                                                          "maxSurge":  "25%",
                                                                          "maxUnavailable":  "25%"
                                                                      },
                                                    "type":  "RollingUpdate"
                                                },
                                   "template":  {
                                                    "metadata":  {
                                                                     "labels":  {
                                                                                    "app":  "demo-ui"
                                                                                }
                                                                 },
                                                    "spec":  {
                                                                 "containers":  [
                                                                                    {
                                                                                        "image":  "nginxinc/nginx-unprivileged:stable-alpine",
                                                                                        "imagePullPolicy":  "IfNotPresent",
                                                                                        "name":  "nginx",
                                                                                        "ports":  [
                                                                                                      {
                                                                                                          "containerPort":  8080,
                                                                                                          "protocol":  "TCP"
                                                                                                      }
                                                                                                  ],
                                                                                        "resources":  {

                                                                                                      },
                                                                                        "securityContext":  {
                                                                                                                "allowPrivilegeEscalation":  false,
                                                                                                                "capabilities":  {
                                                                                                                                     "drop":  [
                                                                                                                                                  "ALL"
                                                                                                                                              ]
                                                                                                                                 },
                                                                                                                "runAsNonRoot":  true,
                                                                                                                "seccompProfile":  {
                                                                                                                                       "type":  "RuntimeDefault"
                                                                                                                                   }
                                                                                                            },
                                                                                        "terminationMessagePath":  "/dev/termination-log",
                                                                                        "terminationMessagePolicy":  "File",
                                                                                        "volumeMounts":  [
                                                                                                             {
                                                                                                                 "mountPath":  "/usr/share/nginx/html",
                                                                                                                 "name":  "html"
                                                                                                             }
                                                                                                         ]
                                                                                    }
                                                                                ],
                                                                 "dnsPolicy":  "ClusterFirst",
                                                                 "restartPolicy":  "Always",
                                                                 "schedulerName":  "default-scheduler",
                                                                 "securityContext":  {

                                                                                     },
                                                                 "terminationGracePeriodSeconds":  30,
                                                                 "volumes":  [
                                                                                 {
                                                                                     "configMap":  {
                                                                                                       "defaultMode":  420,
                                                                                                       "name":  "demo-ui-content"
                                                                                                   },
                                                                                     "name":  "html"
                                                                                 }
                                                                             ]
                                                             }
                                                }
                               }
                  }
              ]
}